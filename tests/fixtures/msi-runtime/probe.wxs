<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="$(var.ProductCode)" Name="Ridge MSI lifecycle probe (CI only)"
           Language="1033" Version="1.0.0" Manufacturer="Ridge CI fixture"
           UpgradeCode="{1B2498C2-CBA6-4943-ADEA-806CA55B7F90}">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="$(var.InstallScope)" Platform="x64" />
    <MediaTemplate EmbedCab="yes" />
    <?if $(var.InstallScope) = "perMachine"?>
      <?define ProbeRegistryRoot="HKLM"?>
    <?else?>
      <?define ProbeRegistryRoot="HKCU"?>
    <?endif?>
    <!-- /f repairs reopen the cached package without our original command-line
         properties. Restore only this fixture's registered installation paths. -->
    <Property Id="RIDGE_PROBE_ROOT" Secure="yes">
      <RegistrySearch Id="ProbeSavedRoot" Root="$(var.ProbeRegistryRoot)" Key="Software\Ridge\MSIProbe\[ProductCode]" Name="Root" Type="raw" Win64="yes" />
    </Property>
    <Property Id="RIDGE_PROBE_HELPER" Secure="yes" />
    <Property Id="RIDGE_PROBE_DATA_DIR" Secure="yes">
      <RegistrySearch Id="ProbeSavedData" Root="$(var.ProbeRegistryRoot)" Key="Software\Ridge\MSIProbe\[ProductCode]" Name="Data" Type="raw" Win64="yes" />
    </Property>
    <Property Id="PROBE_INSTALL" Secure="yes">
      <RegistrySearch Id="ProbeSavedInstall" Root="$(var.ProbeRegistryRoot)" Key="Software\Ridge\MSIProbe\[ProductCode]" Name="Install" Type="raw" Win64="yes" />
    </Property>
    <Property Id="PROBE_MODE" Secure="yes" Value="success" />
    <Property Id="PROBE_LAUNCH_KERNEL" Secure="yes" />
    <Condition Message="This isolated fixture requires an explicit probe directory.">RIDGE_PROBE_ROOT</Condition>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="PROBE_INSTALL" Name="RidgeMsiProbe">
        <Component Id="ProbeSentinel" Guid="{3EAE0A22-C8EF-450C-BB19-E66F1D20E87B}" Win64="yes">
          <File Id="ProbeSentinelFile" Source="$(var.Payload)" Name="sentinel.txt" KeyPath="yes" />
        </Component>
        <Component Id="ProbePaths" Guid="*" Win64="yes">
          <RegistryKey Root="$(var.ProbeRegistryRoot)" Key="Software\Ridge\MSIProbe\[ProductCode]">
            <RegistryValue Name="Root" Type="string" Value="[RIDGE_PROBE_ROOT]" KeyPath="yes" />
            <RegistryValue Name="Data" Type="string" Value="[RIDGE_PROBE_DATA_DIR]" />
            <RegistryValue Name="Install" Type="string" Value="[PROBE_INSTALL]" />
          </RegistryKey>
        </Component>
        <?ifdef WithLiveKernel?>
          <Component Id="ProbeKernel" Guid="{72011B91-82B8-43D0-97E3-1876734EE5EE}" Win64="yes">
            <File Id="ProbeKernelFile" Source="$(var.KernelPath)" Name="ridge-kernel.exe" KeyPath="yes" />
          </Component>
          <Component Id="ProbeCli" Guid="{DD657785-E04A-4236-A194-C2BD89688583}" Win64="yes">
            <File Id="ProbeCliFile" Source="$(var.CliPath)" Name="ridge.exe" KeyPath="yes" />
          </Component>
        <?endif?>
      </Directory>
    </Directory>
    <Feature Id="Probe" Level="1">
      <ComponentRef Id="ProbeSentinel" />
      <ComponentRef Id="ProbePaths" />
      <?ifdef WithRuntimeGuard?>
        <ComponentGroupRef Id="RidgeRuntimeInstallationGuard" />
      <?endif?>
      <?ifdef WithLiveKernel?>
        <ComponentRef Id="ProbeKernel" />
        <ComponentRef Id="ProbeCli" />
      <?endif?>
    </Feature>
    <Binary Id="ProbeDll" SourceFile="$(var.ProbeDll)" />
    <CustomAction Id="ProbeBefore" BinaryKey="ProbeDll" DllEntry="ProbeBefore" Return="check" />
    <CustomAction Id="ProbeContend" BinaryKey="ProbeDll" DllEntry="ProbeContend" Return="check" />
    <CustomAction Id="ProbeWrittenData" Property="ProbeWritten" Value="[RIDGE_PROBE_ROOT]|[RIDGE_PROBE_DATA_DIR]" />
    <CustomAction Id="ProbeFailureData" Property="ProbeFailure" Value="[RIDGE_PROBE_ROOT]|[RIDGE_PROBE_DATA_DIR]" />
    <CustomAction Id="ProbeCancelData" Property="ProbeCancel" Value="[RIDGE_PROBE_ROOT]|[RIDGE_PROBE_DATA_DIR]" />
    <CustomAction Id="ProbeCrashData" Property="ProbeCrash" Value="[RIDGE_PROBE_ROOT]|[RIDGE_PROBE_DATA_DIR]" />
    <CustomAction Id="ProbeWritten" BinaryKey="ProbeDll" DllEntry="ProbeWritten" Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="ProbeFailure" BinaryKey="ProbeDll" DllEntry="ProbeFailure" Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="ProbeCancel" BinaryKey="ProbeDll" DllEntry="ProbeCancel" Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="ProbeCrash" BinaryKey="ProbeDll" DllEntry="ProbeCrash" Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="ProbeSuccess" BinaryKey="ProbeDll" DllEntry="ProbeSuccess" Return="check" />
    <CustomAction Id="ProbeError" BinaryKey="ProbeDll" DllEntry="ProbeError" Return="ignore" />
    <CustomAction Id="ProbeUserExit" BinaryKey="ProbeDll" DllEntry="ProbeUserExit" Return="ignore" />
    <CustomAction Id="ProbeSuspend" BinaryKey="ProbeDll" DllEntry="ProbeSuspend" Return="ignore" />
    <?ifdef WithLiveKernel?>
      <!-- Exercise the real CLI launcher and its installed sibling Kernel,
           outside the CI runner job, with production breakaway flags. -->
      <CustomAction Id="ProbeLaunchKernel" FileKey="ProbeCliFile" ExeCommand="kernel ensure" Return="check" />
    <?endif?>
    <InstallExecuteSequence>
      <Custom Action="ProbeBefore" Before="ProbeContend">1</Custom>
      <Custom Action="ProbeContend" Before="InstallInitialize">1</Custom>
      <Custom Action="ProbeWrittenData" After="InstallFiles">NOT REMOVE</Custom>
      <Custom Action="ProbeFailureData" After="ProbeWrittenData">NOT REMOVE</Custom>
      <Custom Action="ProbeCancelData" After="ProbeFailureData">NOT REMOVE</Custom>
      <Custom Action="ProbeCrashData" After="ProbeCancelData">NOT REMOVE</Custom>
      <Custom Action="ProbeWritten" After="ProbeCrashData">NOT REMOVE</Custom>
      <Custom Action="ProbeCrash" After="ProbeWritten">NOT REMOVE AND PROBE_MODE = "crash"</Custom>
      <Custom Action="ProbeFailure" After="ProbeCrash">NOT REMOVE AND (PROBE_MODE = "failure" OR PROBE_MODE = "crash")</Custom>
      <Custom Action="ProbeCancel" After="ProbeFailure">NOT REMOVE AND PROBE_MODE = "cancel"</Custom>
      <Custom Action="ProbeSuccess" OnExit="success">1</Custom>
      <Custom Action="ProbeError" OnExit="error">1</Custom>
      <Custom Action="ProbeUserExit" OnExit="cancel">1</Custom>
      <Custom Action="ProbeSuspend" OnExit="suspend">1</Custom>
      <?ifdef WithLiveKernel?>
        <Custom Action="ProbeLaunchKernel" After="RidgeRuntimeRelease">NOT Installed AND NOT REMOVE AND PROBE_LAUNCH_KERNEL = "1"</Custom>
      <?endif?>
    </InstallExecuteSequence>
  </Product>
</Wix>
