# Project-specific SpecTree ignore patterns.
# Common generated directories are ignored by default.

# Local checkouts and generated indexes.
.claude/worktrees/
.claude/settings.local.json
ridge-code/
.codegraph/

# Build, package, test, and runtime output.
build/
dist/
remote-dist/
release/
.svelte-kit/
package/
coverage/
test-results/
target/
target-*/
packages/ridge-term/pkg/
scripts/perf-runs/
artifacts/
static/remote/
web-remote-dist/
obsidian-vault/
.ridge/

# Local browser/CDP state.
.webview2-dev-cdp/

# AVD/devtools/diagnostic scripts (tracked for reproducibility, not in the
# spectree graph). Do NOT ignore tracked product source here — hiding
# lock-baseline paths from the hash scan fabricates phantom diffs and breaks
# `stc lock`/`stc verify` policy checks.
scripts/avd-*.mjs
scripts/avd-*.ps1
scripts/bench-*.mjs
scripts/devtools-*.mjs
scripts/diag-*.mjs
scripts/export-diagnostics.mjs
scripts/headed-desktop-e2e.mjs
scripts/security-totp-*.mjs
scripts/tmp-pty-dump.mjs
scripts/tmp-*.mjs

# Local-only generated directories.
static/diag/
apps/

# Machine-local runtime state.
.claude/scheduled_tasks.lock
